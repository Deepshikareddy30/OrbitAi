# Copy to .env and fill in. Never commit the real .env.

# --- Memory: Hindsight Cloud -------------------------------------------------
# Sign up at https://ui.hindsight.vectorize.io/signup to get a key.
MEMORY_STORE=fake
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=trustlens-incidents

# --- No-memory baseline LLM (eval/baseline.py) -------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Courtroom: Advocate vs Challenger ---------------------------------------
# Two separate OpenRouter keys, so each agent's calls/billing/rate-limits are
# isolated. Get keys at https://openrouter.ai/settings/keys
OPENROUTER_ADVOCATE_API_KEY=
OPENROUTER_ADVOCATE_MODEL=dots-studio/dots-3-note-preview:free

OPENROUTER_CHALLENGER_API_KEY=
OPENROUTER_CHALLENGER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
