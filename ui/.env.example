# Copy to .env.local for local dev overrides. Never commit the real .env.local.

# Base URL for the FastAPI backend in production builds (e.g. https://trustlens-api.onrender.com/api).
# In dev, leave unset - vite.config.js proxies /api to VITE_DEV_API_TARGET (default http://127.0.0.1:8000).
VITE_API_BASE=

# Overrides the dev proxy target if the backend isn't on the default port.
VITE_DEV_API_TARGET=
